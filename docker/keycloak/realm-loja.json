{
  "realm": "loja",
  "enabled": true,
  "displayName": "Loja — Async Order Processor",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "accessTokenLifespan": 3600,
  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "Operador: reprocessa pedidos FAILED"
      },
      {
        "name": "CUSTOMER",
        "description": "Cliente: cria e consulta os proprios pedidos"
      }
    ]
  },
  "clients": [
    {
      "clientId": "async-order-processor",
      "name": "Async Order Processor API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "segredo-de-desenvolvimento-trocar-em-producao",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "*"
      ],
      "webOrigins": [
        "*"
      ],
      "attributes": {
        "access.token.lifespan": "3600"
      },
      "protocolMappers": [
        {
          "name": "audience-da-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "async-order-processor",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "async-order-processor-curto",
      "name": "Cliente de vida curta (apenas para teste de expiracao)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "segredo-do-cliente-curto",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "attributes": {
        "access.token.lifespan": "1"
      },
      "protocolMappers": [
        {
          "name": "audience-da-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "async-order-processor",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin@loja.test",
      "email": "admin@loja.test",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Operadora",
      "lastName": "da Loja",
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "ADMIN"
      ]
    },
    {
      "username": "cliente@loja.test",
      "email": "cliente@loja.test",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Ana",
      "lastName": "Souza",
      "credentials": [
        {
          "type": "password",
          "value": "cliente123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "CUSTOMER"
      ]
    }
  ]
}

# Papel do processo: api | relay | consumer
APP_ROLE=api
HTTP_PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=orders
DB_PASSWORD=orders
DB_NAME=orders
# Precisa ser maior que o paralelismo esperado; pool pequeno serializa o que
# deveria ser concorrente.
DB_POOL_SIZE=20

AMQP_URL=amqp://orders:orders@localhost:5672
AMQP_PREFETCH=10
CONSUMER_NAME=order-processor

# Degraus de espera entre retentativas, em ms. Tres degraus = tres retentativas.
RETRY_TIERS_MS=5000,15000,45000
# O "sleep de 1-2s representando a validacao de estoque" do enunciado.
PROCESSING_DELAY_MS=1500

OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=50
MAX_PUBLISH_ATTEMPTS=10

# Provedor de identidade: local (tabela `users` + HS256) ou keycloak (RS256 via JWKS).
# O padrao e `local`: quem so quer rodar o sistema nao paga a subida do Keycloak.
AUTH_PROVIDER=local

# Usado apenas quando AUTH_PROVIDER=keycloak. Suba com:
#   docker compose -f docker-compose.yml -f docker-compose.keycloak.yml up -d --wait
KEYCLOAK_ISSUER=http://keycloak:8080/realms/loja
KEYCLOAK_CLIENT_ID=async-order-processor
KEYCLOAK_CLIENT_SECRET=segredo-de-desenvolvimento-trocar-em-producao

# Usados apenas quando AUTH_PROVIDER=local.
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN_SECONDS=3600

LOG_LEVEL=info

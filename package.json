{
  "name": "async-order-processor",
  "version": "1.0.0",
  "description": "Pedidos com processamento assincrono: API, outbox transacional, fila real e reserva de estoque sem overselling",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/infrastructure/persistence/datasource/cli.datasource.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/infrastructure/persistence/datasource/cli.datasource.ts",
    "db:reset-stock": "docker compose exec -T mysql mysql -uorders -porders orders -e \"UPDATE products SET stock = 5\"",
    "db:reset": "docker compose down -v && docker compose up -d --wait",
    "keycloak:up": "docker compose -f docker-compose.yml -f docker-compose.keycloak.yml up -d --build --wait",
    "keycloak:down": "docker compose -f docker-compose.yml -f docker-compose.keycloak.yml down",
    "load:prep": "bash load/prep.sh 5",
    "load:prep-bulk": "bash load/prep.sh 100000",
    "load:smoke": "k6 run load/k6/smoke.js",
    "load:create": "npm run load:prep-bulk && k6 run load/k6/create-order.js",
    "load:e2e": "npm run load:prep-bulk && k6 run load/k6/end-to-end.js",
    "load:oversell": "npm run load:prep && k6 run load/k6/oversell.js",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test:arch": "jest --selectProjects arch",
    "test:unit": "jest --selectProjects unit",
    "test:fast": "jest --selectProjects arch unit",
    "test:watch": "jest --selectProjects arch unit --watch",
    "test:bdd": "jest --selectProjects bdd --runInBand",
    "test:int": "jest --selectProjects integration --runInBand",
    "test:concurrency": "jest --selectProjects concurrency --runInBand",
    "test:all": "jest --selectProjects arch unit && jest --selectProjects bdd integration concurrency --runInBand",
    "test:cov": "jest --selectProjects unit --coverage",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "amqplib": "^0.10.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "decimal.js": "^10.4.3",
    "mysql2": "^3.11.0",
    "pino": "^9.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tslib": "^2.8.1",
    "typeorm": "^0.3.20",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/jest-runner": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0",
    "@types/amqplib": "^0.10.5",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/micromatch": "^4.0.10",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^5.0.1",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^29.7.0",
    "jest-cucumber": "^4.5.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  }
}
